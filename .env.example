# AWS BetterOps Agent — configuration template.
# Copy to .env and fill in. NEVER commit a real .env.
#
# Variables are grouped by the phase that introduces them. Phase 1 only reads the
# APPLICATION, SECURITY and DATABASE sections; the rest are declared here so the full
# configuration surface is visible from the start.

# ----------------------------------------------------------------------------
# APPLICATION (Phase 1)
# ----------------------------------------------------------------------------
# development | testing | production
APP_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
LOG_LEVEL=INFO
# text | json. Defaults to text in development and json everywhere else.
LOG_FORMAT=text

# ----------------------------------------------------------------------------
# SECURITY (Phase 1)
# ----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-every-environment
SESSION_COOKIE_NAME=betterops_session
# Session lifetime in seconds (default 12 hours)
SESSION_TTL_SECONDS=43200

# ----------------------------------------------------------------------------
# DATABASE — the AWS BetterOps Agent database, not a customer database (Phase 1)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/betterops
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
# Optional: overrides DATABASE_URL when running pytest.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/betterops_test

# ----------------------------------------------------------------------------
# REDIS — cache, rate limiting, distributed locks (Phase 2)
# ----------------------------------------------------------------------------
# redis | memory | disabled.
#   redis    — the real thing (ElastiCache in AWS, the docker-compose service locally)
#   memory   — per-process dictionary, for local development without Redis
#   disabled — every read is a miss and every write a no-op
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
# A slow cache must never stall a request; past this it is treated as a miss.
REDIS_SOCKET_TIMEOUT=0.5

# Cache lifetimes in seconds.
CACHE_TTL_GITHUB_COMMITS=60
CACHE_TTL_GITHUB_FILE=300
CACHE_TTL_CLOUDWATCH=10
CACHE_TTL_INTEGRATION=300
CACHE_TTL_RAG=900
CACHE_TTL_INCIDENT=300

# Rate limits, per identity per minute.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_INVESTIGATIONS_PER_MINUTE=10

# ----------------------------------------------------------------------------
# AWS + BEDROCK (Phase 3)
# ----------------------------------------------------------------------------
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-2-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
MODEL_TEMPERATURE=0.2
MODEL_MAX_OUTPUT_TOKENS=2048

# Agent execution budgets (Phase 3+)
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS_PER_AGENT=12
MAX_AGENTS_PER_INVESTIGATION=7
MAX_MODEL_CALLS_PER_INVESTIGATION=40
MAX_INVESTIGATION_SECONDS=600
AGENT_TIMEOUT_SECONDS=120

# ----------------------------------------------------------------------------
# INTEGRATIONS (Phases 4-6)
# ----------------------------------------------------------------------------
GITHUB_APP_ID=
# Name of the AWS Secrets Manager secret holding the GitHub App private key.
GITHUB_PRIVATE_KEY_SECRET=
GITHUB_WEBHOOK_SECRET=
# External id used when assuming a customer's read-only role.
AWS_ASSUME_ROLE_EXTERNAL_ID=
# Safety limits for the read-only customer PostgreSQL MCP.
CUSTOMER_DB_STATEMENT_TIMEOUT_MS=5000
CUSTOMER_DB_MAX_ROWS=500

# ----------------------------------------------------------------------------
# STORAGE + QUEUE (Phases 7, 9)
# ----------------------------------------------------------------------------
S3_BUCKET_NAME=betterops-documents
SQS_QUEUE_URL=
SQS_VISIBILITY_TIMEOUT=900
# Point AWS SDK calls at LocalStack for local development.
# AWS_ENDPOINT_URL=http://localhost:4566
